DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Any OpenAI-compatible provider works (DeepSeek, Groq, Gemini's OpenAI-compatible endpoint, OpenAI, ...).
# Switching providers is an env-var change only — no source file edits required.
AI_API_KEY=
# Optional — defaults to DeepSeek's deepseek-chat if unset. Set explicitly to use a different
# provider/model.
AI_MODEL=deepseek-chat
# Optional — defaults to DeepSeek's endpoint if unset.
AI_BASE_URL=https://api.deepseek.com
# Optional — short provider label stored on each saved generation
# (generation_contexts.ai_provider). Defaults to "deepseek".
AI_PROVIDER=deepseek
