DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Any OpenAI-compatible provider works (Groq, Gemini's OpenAI-compatible endpoint, OpenAI, ...).
# Switching providers is an env-var change only — no source file edits required.
AI_API_KEY=
# Optional — defaults to Groq's openai/gpt-oss-120b if unset. Set explicitly to use a different
# provider/model.
AI_MODEL=openai/gpt-oss-120b
# Optional — defaults to Groq's endpoint if unset.
AI_BASE_URL=https://api.groq.com/openai/v1
